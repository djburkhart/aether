<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UsingDom</RootNamespace>
    <AssemblyName>Aether.Samples.UsingDom.Document</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Description>Shared UsingDom schema load and Ogre Adventure II document construction.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\testdata\atf\UsingDom\GameSchema.cs" Link="GameSchema.cs" />
    <Content Include="..\..\testdata\atf\UsingDom\game.xsd" Link="game.xsd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\atf\UsingDom\ogre-adventure-ii.xml" Link="ogre-adventure-ii.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aether.Atf.Core\Aether.Atf.Core.csproj" />
    <ProjectReference Include="..\..\src\Aether.Atf.Commands\Aether.Atf.Commands.csproj" />
    <ProjectReference Include="..\..\src\Aether.Atf.PropertyEditing\Aether.Atf.PropertyEditing.csproj" />
  </ItemGroup>

</Project>
