<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sce.Atf</RootNamespace>
    <AssemblyName>Aether.Atf.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <DefineConstants>$(DefineConstants);CS_4;PUBLIC</DefineConstants>
    <!-- Original Atf.Core treated CS0649 as a warning (unassigned fields filled by MEF). -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <Copyright>Copyright © 2014 Sony Computer Entertainment America LLC</Copyright>
    <Company>Sony Computer Entertainment America LLC</Company>
    <Product>Aether Engine</Product>
    <Authors>Sony Computer Entertainment America LLC; Resolvora LLC</Authors>
    <Description>Portable net10.0 port of SonyWWS ATF Atf.Core (DOM, schema, adapters, transactions, selection).</Description>
    <AssemblyTitle>Aether.Atf.Core</AssemblyTitle>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Smallest MEF path: same System.ComponentModel.Composition APIs as ATF, not Microsoft.Extensions.DependencyInjection. -->
    <PackageReference Include="System.ComponentModel.Composition" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ja\Localization.xml" />
    <EmbeddedResource Include="Resources\wws_atf.component" />
  </ItemGroup>

</Project>
