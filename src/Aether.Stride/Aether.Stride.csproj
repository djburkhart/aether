<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aether.Stride</RootNamespace>
    <AssemblyName>Aether.Stride</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Description>Stride Engine host for Aether: Game probe, offscreen RTT presenter, and a Level IGameEngineProxy that creates Entity placeholders.</Description>
    <Product>Aether Engine</Product>
    <Authors>Resolvora LLC</Authors>
    <Copyright>Copyright 2026 Resolvora LLC</Copyright>
    <Version>0.1.0</Version>
    <StridePlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">Windows</StridePlatform>
    <StridePlatform Condition="$([MSBuild]::IsOSPlatform('Linux'))">Linux</StridePlatform>
    <StridePlatform Condition="$([MSBuild]::IsOSPlatform('OSX'))">macOS</StridePlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="4.4.0-beta5" />
    <PackageReference Include="Stride.Shaders.Compilers" Version="4.4.0-beta5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aether.LevelEditor.Core\Aether.LevelEditor.Core.csproj" />
  </ItemGroup>

</Project>
