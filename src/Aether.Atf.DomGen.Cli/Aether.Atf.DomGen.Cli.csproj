<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aether.Atf.DomGen.Cli</RootNamespace>
    <AssemblyName>aether-domgen</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aether-domgen</ToolCommandName>
    <Copyright>Copyright © 2014 Sony Computer Entertainment America LLC</Copyright>
    <Company>Sony Computer Entertainment America LLC</Company>
    <Product>Aether Engine</Product>
    <Authors>Sony Computer Entertainment America LLC; Resolvora LLC</Authors>
    <Description>dotnet CLI for SonyWWS ATF DomGen: generate typed C# from ATF XML schemas.</Description>
    <AssemblyTitle>aether-domgen</AssemblyTitle>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aether.Atf.DomGen\Aether.Atf.DomGen.csproj" />
  </ItemGroup>

</Project>
