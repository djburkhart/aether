<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sce.Atf</RootNamespace>
    <AssemblyName>Aether.Atf.PropertyEditing</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <DefineConstants>$(DefineConstants);CS_4;PUBLIC</DefineConstants>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <Copyright>Copyright © 2014 Sony Computer Entertainment America LLC</Copyright>
    <Company>Sony Computer Entertainment America LLC</Company>
    <Product>Aether Engine</Product>
    <Authors>Sony Computer Entertainment America LLC; Resolvora LLC</Authors>
    <Description>Portable net10.0 port of SonyWWS ATF property-editing logic: TypeDescriptor adapters, DOM property descriptors, editing contexts, converters, and validation hooks. No WinForms/WPF property-grid controls.</Description>
    <AssemblyTitle>Aether.Atf.PropertyEditing</AssemblyTitle>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Composition" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aether.Atf.Core\Aether.Atf.Core.csproj" />
    <ProjectReference Include="..\Aether.Atf.Commands\Aether.Atf.Commands.csproj" />
  </ItemGroup>

</Project>
