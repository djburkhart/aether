<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
             x:Class="Aether.Editor.Views.ScriptView">
  <DockPanel Margin="8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right"
              Content="Run"
              Click="OnRun" />
      <ComboBox x:Name="LanguageBox"
                DockPanel.Dock="Right"
                Width="90"
                Margin="0,0,8,0"
                SelectionChanged="OnLanguageChanged">
        <ComboBoxItem Content="C#" Tag="csharp" />
        <ComboBoxItem Content="Lua" Tag="lua" />
      </ComboBox>
      <TextBlock Text="{Binding Script.StatusText}"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <TextBox DockPanel.Dock="Bottom"
             Height="96"
             Margin="0,8,0,0"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             Text="{Binding Script.Output}" />
    <ae:TextEditor x:Name="Editor"
                   FontFamily="Cascadia Code, Consolas, monospace"
                   FontSize="13"
                   ShowLineNumbers="True"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</UserControl>
