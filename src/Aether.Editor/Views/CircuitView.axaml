<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Aether.Editor.Views"
             x:Class="Aether.Editor.Views.CircuitView">
  <DockPanel Margin="8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right"
              Content="Add And + wire"
              Click="OnAddAnd" />
      <TextBlock Text="Circuit graph"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               Opacity="0.7"
               Text="{Binding Circuit.StatusText}" />
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="#FAFAFA">
      <views:CircuitGraphControl Session="{Binding Circuit}" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
