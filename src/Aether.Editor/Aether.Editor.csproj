<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aether.Editor</RootNamespace>
    <AssemblyName>Aether.Editor</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <Description>Phase 1 Avalonia shell hosting ATF UsingDom, CircuitEditor graph, TimelineEditor, LevelEditor hierarchy bound into a Stride or CPU scene, C# / Lua scripts, a Stride viewport presenter, and property editing.</Description>
    <Product>Aether Engine</Product>
    <Authors>Resolvora LLC</Authors>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.4" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.4" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.4" />
    <PackageReference Include="bodong.Avalonia.PropertyGrid" Version="12.0.4.1" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aether.Atf.Core\Aether.Atf.Core.csproj" />
    <ProjectReference Include="..\Aether.Atf.Commands\Aether.Atf.Commands.csproj" />
    <ProjectReference Include="..\Aether.Atf.PropertyEditing\Aether.Atf.PropertyEditing.csproj" />
    <ProjectReference Include="..\Aether.Plugins\Aether.Plugins.csproj" />
    <ProjectReference Include="..\Aether.Atf.Circuit\Aether.Atf.Circuit.csproj" />
    <ProjectReference Include="..\Aether.Circuit\Aether.Circuit.csproj" />
    <ProjectReference Include="..\Aether.Atf.Timeline\Aether.Atf.Timeline.csproj" />
    <ProjectReference Include="..\Aether.Timeline\Aether.Timeline.csproj" />
    <ProjectReference Include="..\Aether.LevelEditor.Core\Aether.LevelEditor.Core.csproj" />
    <ProjectReference Include="..\Aether.Level\Aether.Level.csproj" />
    <ProjectReference Include="..\Aether.Scripting\Aether.Scripting.csproj" />
    <ProjectReference Include="..\Aether.Stride\Aether.Stride.csproj" />
    <ProjectReference Include="..\..\samples\UsingDom.Document\Aether.Samples.UsingDom.Document.csproj" />
    <ProjectReference Include="..\..\samples\plugins\Aether.SamplePlugin\Aether.SamplePlugin.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\testdata\atf\UsingDom\game.xsd" Link="game.xsd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\atf\UsingDom\ogre-adventure-ii.xml" Link="ogre-adventure-ii.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\atf\CircuitEditor\Circuit.xsd" Link="Circuit.xsd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\atf\CircuitEditor\Example.circuit" Link="Example.circuit" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\atf\TimelineEditor\timeline.xsd" Link="timeline.xsd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\atf\TimelineEditor\100.timeline" Link="100.timeline" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\atf\LevelEditor\level_editor.xsd" Link="level_editor.xsd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\atf\LevelEditor\gap.xsd" Link="gap.xsd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\atf\LevelEditor\LightTest.lvl" Link="LightTest.lvl" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\scripts\resize-bill.csx" Link="resize-bill.csx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\testdata\scripts\resize-bill.lua" Link="resize-bill.lua" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PublishSamplePlugin" AfterTargets="Build">
    <PropertyGroup>
      <_SamplePluginDir>$(MSBuildThisFileDirectory)..\..\samples\plugins\Aether.SamplePlugin\bin\$(Configuration)\net10.0\</_SamplePluginDir>
      <_PluginDest>$(OutputPath)plugins\Aether.SamplePlugin\</_PluginDest>
    </PropertyGroup>
    <MakeDir Directories="$(_PluginDest)" />
    <ItemGroup>
      <_SamplePluginFiles Include="$(_SamplePluginDir)Aether.SamplePlugin.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_SamplePluginFiles)" DestinationFolder="$(_PluginDest)" SkipUnchangedFiles="true" />
  </Target>

</Project>
