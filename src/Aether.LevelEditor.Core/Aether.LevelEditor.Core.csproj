    <RootNamespace>LevelEditorCore</RootNamespace>
    <AssemblyName>Aether.LevelEditor.Core</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Copyright>Copyright © 2014 Sony Computer Entertainment America LLC</Copyright>
    <Company>Sony Computer Entertainment America LLC</Company>
    <Product>Aether Engine</Product>
    <Authors>Sony Computer Entertainment America LLC; Resolvora LLC</Authors>
